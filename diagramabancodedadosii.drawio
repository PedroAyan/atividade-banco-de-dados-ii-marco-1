<mxCell id="legend" value="RELAÇÕES • origem referenciada → destino da FK | 1 = exatamente um; 0..1 = opcional; 0..N = zero ou muitos.&#xa;PK = chave primária | FK = chave estrangeira | U = único | G = coluna gerada.&#xa;&#xa;tb_campus.id_campus → tb_curso.id_campus [1 : 0..N]&#xa;tb_curso.id_curso → tb_curriculo.id_curso [1 : 0..N]&#xa;tb_curriculo.id_curriculo → tb_curriculo_disciplina.id_curriculo [1 : 0..N]&#xa;tb_disciplina.id_disciplina → tb_curriculo_disciplina.id_disciplina [1 : 0..N]&#xa;tb_disciplina.id_disciplina → tb_pre_requisito.id_disciplina [1 : 0..N]&#xa;tb_disciplina.id_disciplina → tb_pre_requisito.id_requisito [1 : 0..N]&#xa;tb_campus.id_campus → tb_sala.id_campus [1 : 0..N]&#xa;tb_campus.id_campus → tb_feriado.id_campus [0..1 : 0..N]&#xa;tb_disciplina.id_disciplina → tb_turma.id_disciplina [1 : 0..N]&#xa;tb_periodo_letivo.id_periodo_letivo → tb_turma.id_periodo_letivo [1 : 0..N]&#xa;tb_professor.id_professor → tb_turma.id_professor [0..1 : 0..N]&#xa;tb_turma.id_turma → tb_turma_horario.id_turma [1 : 0..N]&#xa;tb_sala.id_sala → tb_turma_horario.id_sala [1 : 0..N]&#xa;tb_curso.id_curso → tb_aluno.id_curso [1 : 0..N]&#xa;tb_curriculo.id_curriculo → tb_aluno.id_curriculo [1 : 0..N]&#xa;tb_aluno.id_aluno → tb_matricula.id_aluno [1 : 0..N]&#xa;tb_turma.id_turma → tb_matricula.id_turma [1 : 0..N]&#xa;tb_matricula.id_matricula → tb_historico.id_matricula [1 : 0..1]&#xa;tb_log_matricula: id_matricula não possui FK na referência fornecida; por isso a tabela permanece sem conector." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;" vertex="1" parent="1"><mxGeometry x="50" y="870" width="900" height="300" as="geometry"/></mxCell>
